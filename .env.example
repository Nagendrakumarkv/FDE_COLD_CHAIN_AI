# Copy to .env and fill in real values. Never commit .env.

# Groq (LLM). Create a key at https://console.groq.com/keys
# Pick a model enabled for your account: https://console.groq.com/docs/models
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_enabled_groq_model_id

# Database selection: local or neon
DB_TARGET=neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Local PostgreSQL (only when DB_TARGET=local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cold_chain
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Vector database: chroma or qdrant
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=cold_chain_sop
CHROMA_PATH=vector_db
